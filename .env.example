# ─── DeepL Translation API ─────────────────────────────
# Used by `npm run translate` to auto-generate messages/<locale>.json
# from messages/pt-BR.json for any DeepL-supported locale.
#
# 1) Create a free account: https://www.deepl.com/pro-api
#    Free tier: 500k characters/month (covers the full site easily).
# 2) Copy the API key from the DeepL dashboard.
# 3) Paste it below in .env.local (NEVER commit the real key).
#
# If you upgrade to DeepL Pro, also set DEEPL_PRO=true so the script
# hits the paid endpoint (api.deepl.com instead of api-free.deepl.com).
DEEPL_API_KEY=
# DEEPL_PRO=true

# ─── App configuration ────────────────────────────────
# Add other env vars here as the project grows (e.g., NEXT_PUBLIC_SITE_URL).

# ─── PostHog (Analytics / Funil / Heatmap) ────────────
# 1) Crie conta grátis (EU region) em https://eu.posthog.com/signup
# 2) Em Project Settings, copie "Project API Key" e cole abaixo.
# 3) Em Personal API Keys, gere uma chave server-side e cole em POSTHOG_API_KEY.
# 4) Configure as 3 vars também no painel da Vercel (Production + Preview).
#
# Coleta só dispara depois que o usuário aceitar o banner LGPD do site.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=
# Salt usado pra gerar distinct_id pseudonimizado no backend (rota /api/chat).
# Troque pra um valor aleatório longo em produção.
POSTHOG_ID_SALT=

# ─── n8n (chatbot webhook) ────────────────────────────
# URL do webhook do fluxo "hsb-chatbot-site" no n8n.
# O response DEVE retornar JSON no formato:
#   { "reply": "texto", "step": "service_identified" | "contact_data_collecting" | "contact_data_complete" }
# O campo "step" é opcional, mas necessário pra alimentar o funil no PostHog.
N8N_WEBHOOK_URL=

# ─── n8n (formulário do site) ─────────────────────────
# URL do webhook do fluxo "hsb-lead-form" no n8n. Usado por /api/lead.
# Response esperado em 200: { "ok": true, "lead_key": "..." }
# Se faltando, /api/lead aceita o lead pra UX não quebrar mas dispara
# evento `lead_webhook_missing` no PostHog (= config faltando em prod).
N8N_LEAD_WEBHOOK_URL=
