# ─── Supabase (leads) ─────────────────────────────────────────────────────
# Mesmo projeto Supabase usado pelo site/n8n. A service role key é SECRETA —
# nunca commitar e nunca expor no client.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── PostHog (tráfego, sessões, funil) ────────────────────────────────────
# POSTHOG_API_KEY: chave PESSOAL (phx_...), criada em Settings → Personal API Keys.
# POSTHOG_PROJECT_ID: ID numérico do projeto (Settings → Project).
# POSTHOG_API_HOST: opcional, padrão https://eu.posthog.com (projeto está na EU).
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
