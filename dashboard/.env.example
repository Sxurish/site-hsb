# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dashboard.hsbcompany.com.br

# ─── Supabase (auth + leads) ──────────────────────────────────────────────
# URL e anon key são públicas (client-side). Service role bypassa RLS e é SECRETA.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── PostHog (tráfego, sessões, funil) ────────────────────────────────────
# POSTHOG_API_KEY: Personal API Key (phx_...), com scopes query:read + project:read
# POSTHOG_PROJECT_ID: ID numérico do projeto (Settings → Project)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
