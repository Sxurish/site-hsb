# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública do dashboard (usada em metadataBase e assetPrefix)
NEXT_PUBLIC_SITE_URL=https://dashboard.hsbcompany.com

# ─── Autenticação (Fase 1 — credencial única via env) ─────────────────────────
# Gere o segredo com: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Fase 2 (futuro): substituir por NextAuth ou Supabase Auth para multi-usuário
# NEXTAUTH_URL=https://dashboard.hsbcompany.com
# NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Supabase (banco de dados — leads, métricas) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── PostHog (métricas de comportamento do site público) ─────────────────────
POSTHOG_API_KEY=             # chave server-side (Personal API Key)
POSTHOG_PROJECT_ID=          # ID numérico do projeto no PostHog

# ─── Notion (pipeline comercial) ──────────────────────────────────────────────
NOTION_TOKEN=                # Integration token (Internal Integration)
NOTION_DATABASE_ID=          # ID do database de pipeline

# ─── n8n (automações, geração de relatórios) ──────────────────────────────────
N8N_WEBHOOK_URL=             # URL do webhook do fluxo de relatórios no n8n
